summaries:
  Filled: values.filter(!value.isType("null")).length
formulas:
  mood_count: mood.length
  mood_list: mood.join(", ")
  mood_sentiment: if(mood.containsAny("Happy", "Excited", "Good", "Calm", "Hopeful"), if(mood.containsAny("anxious", "frustrated", "Sad", "exhausted", "Empty"), "🟡 Mixed", "🟢 Positive"), "🔴 Negative")
  influencer_count: note["mood-influencers"].length
  primary_influencer: if(note["mood-influencers"].length > 0, note["mood-influencers"][0], "None")
  influencers_list: note["mood-influencers"].join(", ")
  days_ago: (today() - created.date()) / (1000 * 60 * 60 * 24)
  entry_recency: if(days_ago <= 7, "🔴 Recent", if(days_ago <= 30, "🟡 Active", "🔵 Archive"))
properties:
  mood:
    displayName: 🎭 Moods
  mood-influencers:
    displayName: 🎯 Influencers
  topics:
    displayName: 📌 Topics
  tags:
    displayName: 🔖 Tags
  created:
    displayName: 📅 Created
  date:
    displayName: 📆 Date
  formula.mood_count:
    displayName: "# Moods"
  formula.mood_list:
    displayName: Mood Summary
  formula.mood_sentiment:
    displayName: 📊 Sentiment
  formula.influencer_count:
    displayName: "# Factors"
  formula.primary_influencer:
    displayName: 🎯 Main Factor
  formula.influencers_list:
    displayName: All Factors
  formula.days_ago:
    displayName: Days Ago
  formula.entry_recency:
    displayName: 📍 Status
views:
  - type: table
    name: General
    filters:
      and:
        - file.tags.contains("Dailynote")
    order:
      - file.name
      - formula.mood_sentiment
      - formula.mood_list
      - formula.influencer_count
      - formula.primary_influencer
      - created
    sort:
      - property: created
        direction: DESC
      - property: formula.influencer_count
        direction: ASC
    summaries:
      formula.mood_count: Average
      formula.influencer_count: Average
      file.name: Filled
    columnSize:
      file.name: 200
      formula.mood_sentiment: 120
      formula.mood_list: 350
      formula.influencer_count: 100
      formula.primary_influencer: 150
      note.created: 294
  - type: table
    name: Current Mood Snapshot
    filters:
      and:
        - file.tags.contains("Dailynote")
        - created >= today() - "7d"
    order:
      - file.name
      - formula.mood_sentiment
      - formula.mood_list
      - formula.influencer_count
      - formula.primary_influencer
      - formula.entry_recency
    sort: []
    summaries:
      formula.mood_count: Average
      formula.influencer_count: Average
    columnSize:
      file.name: 180
      formula.mood_sentiment: 120
      formula.mood_list: 300
      formula.influencer_count: 142
      formula.primary_influencer: 140
      formula.entry_recency: 120
  - type: table
    name: Mood Trends - By Month
    filters:
      and:
        - file.tags.contains("Dailynote")
    order:
      - file.name
      - formula.mood_sentiment
      - formula.mood_count
      - created
      - formula.mood_list
    sort: []
    summaries:
      formula.mood_count: Average
      file.name: Unique
    columnSize:
      file.name: 200
      formula.mood_sentiment: 120
      formula.mood_count: 100
      note.created: 150
  - type: table
    name: Negative Mood Focus
    filters:
      and:
        - file.tags.contains("Dailynote")
        - or:
            - mood.contains("anxious")
            - mood.contains("Sad")
            - mood.contains("frustrated")
            - mood.contains("hopeless")
            - mood.contains("Empty")
            - mood.contains("Colorless")
            - mood.contains("Despair")
            - mood.contains("hopeless")
            - mood.contains("afraid")
    order:
      - file.name
      - formula.mood_sentiment
      - formula.mood_list
      - created
    sort:
      - property: created
        direction: ASC
      - property: formula.influencers_list
        direction: ASC
    summaries:
      file.name: Unique
      formula.influencer_count: Average
    columnSize:
      file.name: 200
      formula.mood_sentiment: 120
      formula.mood_list: 365
      formula.influencers_list: 300
      note.created: 150
  - type: cards
    name: Influencer Impact Analysis
    filters:
      and:
        - file.tags.contains("Dailynote")
    order:
      - formula.mood_sentiment
      - created
      - formula.primary_influencer
      - file.fullname
      - formula.influencer_count
      - formula.mood_count
      - formula.mood_list
    summaries:
      file.name: Unique
      formula.mood_count: Average
    columnSize:
      file.name: 200
      formula.mood_sentiment: 120
      note.created: 150
  - type: table
    name: Influencer Analysis - Table
    filters:
      and:
        - file.tags.contains("Dailynote")
    order:
      - file.name
      - formula.mood_sentiment
      - formula.mood_list
      - formula.influencer_count
      - created
      - formula.primary_influencer
      - formula.influencers_list
    summaries:
      file.name: Unique
      formula.mood_count: Average
      formula.influencer_count: Average
    columnSize:
      file.name: 200
      formula.mood_sentiment: 120
      formula.mood_list: 350
      formula.influencer_count: 144
      note.created: 150
      formula.primary_influencer: 150
  - type: list
    name: Positive Days Log
    filters:
      and:
        - file.tags.contains("Dailynote")
        - or:
            - mood.contains("Happy")
            - mood.contains("Excited")
            - mood.contains("Good")
            - mood.contains("Calm")
            - mood.contains("Hopeful")
    order:
      - formula.mood_list
      - formula.influencers_list
      - formula.days_ago
      - file.name
    sort: []
    markers: bullets
  - type: table
    name: By Mood
    filters:
      and:
        - file.tags.contains("Dailynote")
    order:
      - file.name
      - formula.mood_sentiment
      - formula.influencer_count
      - created
      - formula.mood_count
      - formula.mood_list
    sort:
      - property: formula.mood_count
        direction: DESC
    summaries:
      file.name: Unique
    columnSize:
      file.name: 220
      formula.mood_sentiment: 120
      formula.influencer_count: 152
      note.created: 150
  - type: table
    name: By Influencer
    filters:
      and:
        - file.tags.contains("Dailynote")
    order:
      - file.name
      - formula.mood_sentiment
      - formula.mood_list
      - created
      - mood-influencers
    summaries:
      file.name: Unique
    columnSize:
      file.name: 220
      formula.mood_sentiment: 120
      formula.mood_list: 437
      note.created: 150
