{
	"nodes":[
		{"id":"title","type":"text","x":360,"y":20,"width":560,"height":60,"text":"# Personal AI Powerhouse — Architecture Map\n\n`personal-ai-space/` and supporting services"},
		{"id":"engine-group","type":"group","x":30,"y":110,"width":800,"height":580,"label":"ENGINE — AI Brain","color":"6"},
		{"id":"engine-core","type":"text","x":50,"y":150,"width":180,"height":70,"text":"**engine.py**\nOrchestrator — loads agents,\nroutes messages, runs jobs","color":"5"},
		{"id":"cli-core","type":"text","x":245,"y":150,"width":180,"height":70,"text":"**cli.py**\n20+ user commands — health,\ntasks, habits, memory, learning","color":"5"},
		{"id":"db-core","type":"text","x":440,"y":150,"width":180,"height":70,"text":"**db_manager.py**\nSQLite connection pool,\nqueries, health checks","color":"5"},
		{"id":"log-core","type":"text","x":635,"y":150,"width":180,"height":70,"text":"**log_manager.py**\nStructured logging,\naudit trail, perf tracking","color":"5"},
		{"id":"agents-header","type":"text","x":50,"y":245,"width":300,"height":30,"text":"### Agents (6 active)","color":"6"},
		{"id":"agent-cm","type":"text","x":50,"y":285,"width":240,"height":55,"text":"**context-manager**\nProfile + session + MCP memory bridge","color":"1"},
		{"id":"agent-tc","type":"text","x":305,"y":285,"width":240,"height":55,"text":"**task-coordinator**\nTask CRUD, priorities, dependencies","color":"1"},
		{"id":"agent-ig","type":"text","x":560,"y":285,"width":240,"height":55,"text":"**insight-generator**\nHabit analysis, patterns, anomalies","color":"1"},
		{"id":"agent-rs","type":"text","x":50,"y":350,"width":240,"height":55,"text":"**reminder-system**\nScheduled + event-based reminders","color":"1"},
		{"id":"agent-ki","type":"text","x":305,"y":350,"width":240,"height":55,"text":"**knowledge-indexer**\nIndex, search, deduplicate knowledge","color":"1"},
		{"id":"agent-rg","type":"text","x":560,"y":350,"width":240,"height":55,"text":"**report-generator**\nDaily digest, weekly review, monthly","color":"1"},
		{"id":"learning-header","type":"text","x":50,"y":425,"width":350,"height":30,"text":"### Learning System (autonomous)","color":"4"},
		{"id":"agent-bo","type":"text","x":50,"y":465,"width":240,"height":55,"text":"**behavior-observer**\nLogs actions, task completions, habits","color":"4"},
		{"id":"agent-pl","type":"text","x":305,"y":465,"width":240,"height":55,"text":"**pattern-learner**\nInfers time patterns, preferences, workflows","color":"4"},
		{"id":"memory-header","type":"text","x":560,"y":425,"width":250,"height":30,"text":"### MCP Memory Server (Node.js)","color":"5"},
		{"id":"mcp-bridge","type":"text","x":560,"y":465,"width":240,"height":55,"text":"**mcp_bridge.py**\nPython → Node subprocess bridge","color":"5"},
		{"id":"mcp-store","type":"text","x":50,"y":535,"width":180,"height":50,"text":"**store.ts**\nSQLite CRUD (facts,\nlessons, events)","color":"3"},
		{"id":"mcp-consolidator","type":"text","x":245,"y":535,"width":180,"height":50,"text":"**consolidator.ts**\nLLM knowledge\nextraction & dedup","color":"3"},
		{"id":"mcp-injector","type":"text","x":440,"y":535,"width":180,"height":50,"text":"**injector.ts**\nContext injection\ninto agent prompts","color":"3"},
		{"id":"mcp-nlp","type":"text","x":635,"y":535,"width":180,"height":50,"text":"**nlp-interface.ts**\nIntent routing + tool\ncall extraction","color":"3"},
		{"id":"mcp-cli","type":"text","x":50,"y":600,"width":180,"height":50,"text":"**cli.ts / demo-cli.ts**\nInteractive REPL for\nmemory operations","color":"3"},
