{
  "version": "1.0",
  "endpoints": {
    "TASK_MANAGEMENT": {
      "description": "Manage tasks in the Personal AI Powerhouse system",
      "mcp_server": "task-management-mcp",
      "methods": [
        {
          "name": "list_tasks",
          "description": "List tasks with optional filtering",
          "params": {
            "due_date": "Optional date filter (YYYY-MM-DD)",
            "status": "Optional status filter",
            "limit": "Maximum results (default: 20)"
          },
          "returns": "Array of task objects"
        },
        {
          "name": "create_task",
          "description": "Create a new task",
          "params": {
            "title": "Task title (required)",
            "description": "Task description",
            "due_date": "Due date (YYYY-MM-DD)",
            "project_id": "Associated project ID"
          },
          "returns": "Task ID and success status"
        },
        {
          "name": "update_task_status",
          "description": "Update task status",
          "params": {
            "task_id": "Task ID (required)",
            "new_status": "New status (required)"
          },
          "returns": "Success status"
        },
        {
          "name": "get_task_details",
          "description": "Get detailed task information",
          "params": {
            "task_id": "Task ID (required)"
          },
          "returns": "Task object with full details"
        }
      ],
      "access_level": "read_write",
      "auth_required": false
    },
    "APPOINTMENT": {
      "description": "Access calendar and appointments",
      "mcp_server": "appointment-mcp",
      "methods": [
        {
          "name": "get_appointments",
          "description": "Get appointments with optional date range",
          "params": {
            "date_range": "Date range (YYYY-MM-DD to YYYY-MM-DD)",
            "limit": "Maximum results (default: 20)"
          },
          "returns": "Array of appointment objects"
        },
        {
          "name": "create_appointment",
          "description": "Create a new appointment",
          "params": {
            "title": "Appointment title (required)",
            "start_time": "Start time (ISO format, required)",
            "end_time": "End time (ISO format, required)",
            "location": "Location",
            "description": "Description"
          },
          "returns": "Appointment ID and success status"
        },
        {
          "name": "get_appointment_details",
          "description": "Get detailed appointment information",
          "params": {
            "appointment_id": "Appointment ID (required)"
          },
          "returns": "Appointment object with full details"
        }
      ],
      "access_level": "read_write",
      "auth_required": false
    },
    "PROJECT_CONTEXT": {
      "description": "Access project context and related data",
      "mcp_server": "project-context-mcp",
      "methods": [
        {
          "name": "get_project_context",
          "description": "Get full context for a project",
          "params": {
            "project_id": "Project ID (required)"
          },
          "returns": "Project object with tasks and knowledge items"
        },
        {
          "name": "update_project_context",
          "description": "Update project context",
          "params": {
            "project_id": "Project ID (required)",
            "new_data": "Dictionary of updates (required)"
          },
          "returns": "Success status"
        },
        {
          "name": "list_projects",
          "description": "List all projects",
          "params": {
            "status": "Optional status filter",
            "limit": "Maximum results (default: 20)"
          },
          "returns": "Array of project objects"
        }
      ],
      "access_level": "read_write",
      "auth_required": false
    }
  },
  "agents": {
    "hermes": {
      "description": "Primary AI assistant",
      "capabilities": ["TASK_MANAGEMENT", "APPOINTMENT", "PROJECT_CONTEXT"],
      "access_level": "full",
      "default_model": "mistralai/mistral-small-latest",
      "fallback_model": "openrouter/mistralai/devstral-small"
    },
    "opencode": {
      "description": "Coding assistant",
      "capabilities": ["TASK_MANAGEMENT", "PROJECT_CONTEXT"],
      "access_level": "limited",
      "default_model": "openrouter/mistralai/devstral-small"
    }
  },
  "usage_examples": {
    "list_todays_tasks": {
      "endpoint": "TASK_MANAGEMENT",
      "method": "list_tasks",
      "params": {
        "due_date": "2026-05-16",
        "status": "pending"
      },
      "description": "Get all pending tasks due today"
    },
    "create_project_task": {
      "endpoint": "TASK_MANAGEMENT",
      "method": "create_task",
      "params": {
        "title": "Implement MCP endpoint",
        "description": "Create task management MCP server",
        "project_id": "ai-powerhouse",
        "due_date": "2026-05-20"
      },
      "description": "Create a task associated with a project"
    }
  },
  "rate_limits": {
    "default": {
      "requests_per_minute": 60,
      "burst_limit": 10
    },
    "hermes": {
      "requests_per_minute": 120,
      "burst_limit": 20
    }
  }
}