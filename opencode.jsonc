{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "opencode-mem-mcp": {
      "type": "local",
      "command": [
        "/Users/paulorezende/Documents/Personal_AI_powerhouse/mcp-servers/opencode-mem-mcp/.venv/bin/opencode-mem-mcp"
      ],
      "enabled": true
    },
    "task-management-mcp": {
      "type": "local",
      "command": ["task-management-mcp"],
      "enabled": true
    },
    "appointment-mcp": {
      "type": "local",
      "command": ["appointment-mcp"],
      "enabled": true
    },
    "project-context-mcp": {
      "type": "local",
      "command": ["project-context-mcp"],
      "enabled": true
    },
    "aivectormemory": {
      "type": "local",
      "command": [
        "aivectormemory",
        "--project-dir",
        "/Users/paulorezende/Documents/Personal_AI_powerhouse"
      ],
      "enabled": false
    }
  }
}