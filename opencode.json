{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aivectormemory": {
      "type": "local",
      "command": [
        "/usr/bin/env",
        "AIVM_MODEL_NAME=Xenova/all-MiniLM-L6-v2",
        "/Users/paulorezende/.local/share/uv/tools/aivectormemory/bin/python",
        "-m",
        "aivectormemory",
        "--project-dir",
        "/Users/paulorezende/Documents/Personal_AI_powerhouse updated"
      ],
      "enabled": true
    },
    "mempalace": {
      "type": "local",
      "command": [
        "/usr/bin/python3",
        "-m",
        "mempalace.mcp_server"
      ],
      "enabled": true
    },
    "ong-vault-bridge": {
      "type": "local",
      "command": [
        "/Users/paulorezende/Library/Mobile Documents/iCloud~md~obsidian/Documents/ONG/NEDS/agents_workspace/bridge/run.sh"
      ],
      "enabled": true
    },
    "whatsapp-mcp": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "--add-host", "host.docker.internal:host-gateway",
        "-e", "WHATSAPP_API_URL=http://host.docker.internal:8080/api",
        "-v", "/Users/paulorezende/Documents/Cline/MCP/whatsapp-mcp/whatsapp-bridge/store:/data",
        "mcp/whatsapp-mcp:latest"
      ],
      "enabled": true
    }
