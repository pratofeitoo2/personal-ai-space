    stroke-dash: 4
    border-radius: 8
    font-color: "#64748b"
    font-size: 10
  }

  memories_db: "memories.db\nInteractions\nContext Windows" {
    style: {
      fill: "#4c1d95"
      stroke: "#a78bfa"
      border-radius: 6
      font-color: "#ddd6fe"
      font-size: 10
    }
  }

  mcp_bridge: "MCP Memory Bridge\nPython → Node.js\nSQLite + semantic" {
    style: {
