# ──────────────────────────────────────────────────────────────
# Personal AI Powerhouse — Agent Communication Flow
# Shows Engine.send() dispatch, EventBus, circuit breaker, observer
# ──────────────────────────────────────────────────────────────
d2-config: {
  layout-engine: elk
  theme: 1
  pad: 40
  sketch: false
}

title: |md
  # 🧠 Agent Communication & Dispatch
  ### EventBus, Circuit Breaker & Observer Pattern
| {
  shape: text
  style: {
    fill: transparent
    stroke: transparent
    font-color: "#f1f5f9"
    font-size: 28
    bold: true
  }
}

# ── ENTRY ─────────────────────────────────────────────────────
entry: {
  label: "ENTRY"
  style: {
    fill: "#0c1929"
    stroke: "#1e293b"
    stroke-dash: 4
    border-radius: 8
    font-color: "#64748b"
    font-size: 10
  }

  cli: "CLI / HTTP / OpenCode" {
    style: {
      fill: "#0e7490"
      stroke: "#22d3ee"
      border-radius: 6
      font-color: "#cffafe"
      font-size: 12
      shadow: true
    }
  }
}

# ── ENGINE (the message bus) ──────────────────────────────────
engine: {
  label: "ENGINE — Message Dispatch Layer"
  style: {
    fill: "#0a1f14"
    stroke: "#1e293b"
    stroke-dash: 4
    border-radius: 8
    font-color: "#64748b"
    font-size: 10
  }

  engine_py: "Engine.py\nOrchestrator" {
    style: {
      fill: "#065f46"
      stroke: "#34d399"
      border-radius: 6
      font-color: "#d1fae5"
      font-size: 14
      shadow: true
    }
  }

  eventbus: "EventBus\nTopic-based pub/sub" {
    style: {
      fill: "#9a3412"
      stroke: "#fb923c"
      border-radius: 6
      font-color: "#fed7aa"
      font-size: 11
      shadow: true
    }
  }

  send_chain: {
    style: {
      fill: "#1e293b"
      stroke: "#64748b"
      stroke-dash: 4
      border-radius: 6
      font-color: "#cbd5e1"
      font-size: 9
    }

    step1: "1. Engine.send(agent, cmd, data)" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 10
      }
    }
    step2: "2. agent.handle(message)" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 10
      }
    }
    step3: "3. DataHub.log_interaction()" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 10
      }
    }
    step4: "4. BehaviorObserver.observe()" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 10
      }
    }
    step5: "5. Every 5th call: context_snapshot" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 10
      }
    }
    step6: "6. Notify github-agent (fire-and-forget)" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 10
      }
    }
  }

  send_chain.step1 -> send_chain.step2
  send_chain.step2 -> send_chain.step3
  send_chain.step3 -> send_chain.step4
  send_chain.step4 -> send_chain.step5
  send_chain.step5 -> send_chain.step6
}

