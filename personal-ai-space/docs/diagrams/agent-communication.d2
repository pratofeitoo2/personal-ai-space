# ══════════════════════════════════════════════════════════════
# CONNECTIONS
# ══════════════════════════════════════════════════════════════

# Entry → Engine
entry.cli -> engine.engine_py: "user commands"

# Engine dispatch
engine.engine_py -> engine.eventbus: "dispatches EventEnvelope"
engine.engine_py -> engine.send_chain: "send() chain→"

# Engine → Broadcast via EventBus
engine.engine_py -> agents: "Engine.send() direct"

# EventBus topics (these are the actual subscriptions)
agents.ctx_mgr -> engine.eventbus: "subscribes: context.*"
agents.task_cord -> engine.eventbus: "subscribes: tasks.*"
agents.insight_gen -> engine.eventbus: "subscribes: insights.*"
agents.reminder -> engine.eventbus: "subscribes: reminders.*"
agents.report_gen -> engine.eventbus: "subscribes: reports.*"
agents.knowledge_idx -> engine.eventbus: "subscribes: knowledge.*"
agents.mcp_agent -> engine.eventbus: "subscribes: mcp.*"
agents.github_agent -> engine.eventbus: "subscribes: github.*"

# Engine → observers (wired at init)
engine.engine_py -> observer: "set_observer() injects at startup"

# Observer observes everything (transparent)
observer.behavior_obs -> agents: "transparently observes all agent actions"
observer.pattern_lrn -> observer.behavior_obs: "reads observation history"

# Persistence
engine.engine_py -> storage.memories_db: "log_interaction()"
agents.ctx_mgr -> storage.mcp_bridge: "add_fact / add_lesson"
observer -> storage.mcp_bridge: "observation facts"
agents -> storage: "CRUD via DataHub / db_manager"

# Cross-agent notification (every non-github success)
agents -> agents.github_agent: "agent_work_completed event"

# Circuit breaker isolation
engine.eventbus -> agents.circuit_breaker_zone: "messages pass through"
agents.mcp_agent -> agents.circuit_breaker_zone: "3 fails → OPEN"

