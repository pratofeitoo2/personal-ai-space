# ══════════════════════════════════════════════════════════════
# CONNECTIONS
# ══════════════════════════════════════════════════════════════

# Entry → Orchestration
entry.cli -> orchestration.engine_py: "invokes"
entry.http_daemon -> orchestration.engine_py: "RPC calls"
entry.opencode -> orchestration.engine_py: "lifecycle hooks"

# Orchestration internals
orchestration.engine_py -> orchestration.eventbus: "dispatches"
orchestration.engine_py -> orchestration.log_manager: "audits"
orchestration.engine_py -> orchestration.appconfig: "reads config"
orchestration.engine_py -> orchestration.synthesis_module: "triggers"
orchestration.engine_py -> orchestration.llm_bridge: "LLM calls"
orchestration.datahub -> orchestration.db_manager: "typed facade"

# Orchestration → Agents
orchestration.engine_py -> agents: "Engine.send() dispatch"

# Agent connections to storage
agents.ctx_mgr -> storage.self_db: "reads profile"
agents.ctx_mgr -> storage.mcp_bridge_py: "memory ops"
agents.task_cord -> storage.tasks_db: "CRUD tasks"
agents.task_cord -> storage.self_db: "reads habits"
agents.insight_gen -> storage.self_db: "analyzes habits"
agents.reminder -> storage.tasks_db: "checks due dates"
agents.report_gen -> storage: "reads from all"
agents.knowledge_idx -> storage.knowledge_db: "indexes/searches"
agents.mcp_agent -> orchestration.mcp_transport: "MCP calls"
agents.github_agent -> storage.git_db: "syncs repos"
agents.github_agent -> infrastructure.gh_cli: "git/gh ops"
agents.behavior_obs -> storage.mcp_bridge_py: "facts"
agents.pattern_lrn -> storage: "reads historical"

# Storage internal
storage.mcp_bridge_py -> storage.headless_js: "stdin JSON-RPC"
storage.fallback_mem -> storage.mcp_bridge_py: "SQLite failover"
storage.mcp_bridge_py -> storage.mempalace: "semantic sync"

# Storage ↔ Self
storage.self_db <-> self: "sync_self.py syncs"

# Infrastructure connections
infrastructure.external.ollama -> orchestration.llm_bridge: "embeddings/gen"
orchestration.mcp_transport -> infrastructure.external.mail_mcp: "MCP calls"
infrastructure.external.github_actions -> agents: "CI validation"

# Intake flow
infrastructure.intake.launchd -> infrastructure.intake.processor: "new file dropped"
infrastructure.intake.processor -> infrastructure.intake.extractor: "6-phase extraction"
infrastructure.intake.extractor -> storage: "populates DBs"
infrastructure.intake.extractor -> self: "populates twin"

