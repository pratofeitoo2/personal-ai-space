# ──────────────────────────────────────────────────────────────
# Personal AI Powerhouse — Container Architecture (C4 Level 2)
# Dark-tech design system — semantic color coding
# ──────────────────────────────────────────────────────────────
d2-config: {
  layout-engine: tala
  theme: 1
  pad: 30
  sketch: false
}

title: |md
  # 🧠 Personal AI Powerhouse
  ### Container Architecture · C4 Level 2
| {
  shape: text
  style: {
    fill: transparent
    stroke: transparent
    font-color: "#f1f5f9"
    font-size: 28
    bold: true
  }
}

# ── ENTRY POINTS ─────────────────────────────────────────────
