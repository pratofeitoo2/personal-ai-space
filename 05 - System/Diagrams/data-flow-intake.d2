# ──────────────────────────────────────────────────────────────
# Personal AI Powerhouse — Data Flow: File Intake Pipeline
# Shows how files flow from drop to persistent storage
# ──────────────────────────────────────────────────────────────
d2-config: {
  layout-engine: dagre
  theme: 1
  pad: 40
  sketch: false
}

title: |md
  # 📥 Data Flow — Intake Pipeline
  ### Zero-touch file import via macOS launchd
| {
  shape: text
  style: {
    fill: transparent
    stroke: transparent
    font-color: "#f1f5f9"
    font-size: 28
    bold: true
  }
}

# ── INPUT ───────────────────────────────────────────────────
input: {
  label: "INPUT"
  style: {
    fill: "#0c1929"
    stroke: "#1e293b"
    stroke-dash: 4
    border-radius: 8
    font-color: "#64748b"
    font-size: 10
  }

  dropzone: "User drops files\nintake/staging/" {
    style: {
      fill: "#0e7490"
      stroke: "#22d3ee"
      border-radius: 6
      font-color: "#cffafe"
      font-size: 12
      shadow: true
    }
  }

  obsidian: "Obsidian Vault\n(project root)" {
    style: {
      fill: "#0e7490"
      stroke: "#22d3ee"
      border-radius: 6
      font-color: "#cffafe"
      font-size: 10
      shadow: true
    }
  }

  opencode: "OpenCode\n(agent sessions)" {
    style: {
      fill: "#0e7490"
      stroke: "#22d3ee"
      border-radius: 6
      font-color: "#cffafe"
      font-size: 10
      shadow: true
    }
  }
}

# ── TRIGGER ──────────────────────────────────────────────────
trigger: "launchd Watcher\nmacOS service\nPoll: 10s, Debounce: 60s" {
  style: {
    fill: "#92400e"
    stroke: "#fbbf24"
    border-radius: 6
    font-color: "#fde68a"
    font-size: 11
    shadow: true
  }
}

# ── PROCESS PIPELINE ────────────────────────────────────────
pipeline: {
  label: "PROCESSING PIPELINE"
  style: {
    fill: "#0a1f14"
    stroke: "#1e293b"
    stroke-dash: 4
    border-radius: 8
    font-color: "#64748b"
    font-size: 10
  }

  convert: "1. Convert\n.txt → .md\n.pdf → .md\n.docx → .md" {
    style: {
      fill: "#065f46"
      stroke: "#34d399"
      border-radius: 6
      font-color: "#d1fae5"
      font-size: 10
    }
  }

  frontmatter: "2. Frontmatter\nStandardize YAML" {
    style: {
      fill: "#065f46"
      stroke: "#34d399"
      border-radius: 6
      font-color: "#d1fae5"
      font-size: 10
    }
  }

  route: {
    label: "3. Route"
    style: {
      fill: "#1e293b"
      stroke: "#64748b"
      stroke-dash: 4
      border-radius: 6
      font-color: "#cbd5e1"
      font-size: 9
    }

    type_route: "type_routes (19 rules)" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 9
      }
    }
    tag_route: "tag_routes (4)" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 9
      }
    }
    folder_route: "folder_routes (5)" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 9
      }
    }
    filename_route: "filename_routes (5)" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 9
      }
    }
    date_route: "date_patterns (4)" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 9
      }
    }
    default_route: "default → knowledge/notes" {
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-color: "#e2e8f0"
        font-size: 9
      }
    }

    type_route -> tag_route
    tag_route -> folder_route
    folder_route -> filename_route
    filename_route -> date_route
    date_route -> default_route
  }

  archive: "4. Archive\nMove to intake/processed/" {
    style: {
      fill: "#065f46"
      stroke: "#34d399"
      border-radius: 6
      font-color: "#d1fae5"
      font-size: 10
    }
  }
}

