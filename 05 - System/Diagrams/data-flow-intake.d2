      }
    }
  }

  knowledge: {
    label: "Knowledge"
    style: {
      fill: "#0f172a"
      stroke: "#334155"
      stroke-dash: 4
      border-radius: 8
      font-color: "#94a3b8"
      font-size: 9
    }

    articles: "knowledge/articles/" {
      style: {
        fill: "#92400e"
        stroke: "#fbbf24"
        border-radius: 6
        font-color: "#fde68a"
        font-size: 10
      }
    }
    notes: "knowledge/notes/" {
      style: {
        fill: "#92400e"
        stroke: "#fbbf24"
        border-radius: 6
        font-color: "#fde68a"
        font-size: 10
      }
    }
    references: "knowledge/references/" {
      style: {
        fill: "#92400e"
        stroke: "#fbbf24"
        border-radius: 6
        font-color: "#fde68a"
        font-size: 10
      }
    }
    projects: "knowledge/projects/" {
      style: {
        fill: "#92400e"
        stroke: "#fbbf24"
        border-radius: 6
        font-color: "#fde68a"
        font-size: 10
      }
    }
  }

  self_dest: {
    label: "Digital Twin"
    style: {
      fill: "#0f172a"
      stroke: "#334155"
      stroke-dash: 4
      border-radius: 8
      font-color: "#94a3b8"
      font-size: 9
    }

    profile_dest: "self/profile.json" {
      style: {
        fill: "#92400e"
        stroke: "#fbbf24"
        border-radius: 6
        font-color: "#fde68a"
        font-size: 10
      }
    }
    goals_dest: "self/goals/" {
      style: {
        fill: "#92400e"
        stroke: "#fbbf24"
        border-radius: 6
        font-color: "#fde68a"
        font-size: 10
      }
    }
    relationships_dest: "self/relationships/" {
      style: {
        fill: "#92400e"
        stroke: "#fbbf24"
        border-radius: 6
        font-color: "#fde68a"
        font-size: 10
      }
    }
  }
}

# ── POST-PROCESS ─────────────────────────────────────────────
post_process: "👇 ComprehensiveExtractor\n6-phase extraction to all 5 SQLite DBs" {
  style: {
    fill: "#1e3a5f"
    stroke: "#60a5fa"
    border-radius: 6
    font-color: "#bfdbfe"
    font-size: 11
    shadow: true
  }
}

# ── DATABASES ───────────────────────────────────────────────
databases: {
  label: "DATABASES"
  style: {
    fill: "#140a26"
    stroke: "#1e293b"
    stroke-dash: 4
    border-radius: 8
    font-color: "#64748b"
    font-size: 10
  }

  tasks_db: "tasks.db" {
    style: {
      fill: "#4c1d95"
      stroke: "#a78bfa"
      border-radius: 6
      font-color: "#ddd6fe"
      font-size: 10
    }
  }
  self_db: "self.db" {
    style: {
      fill: "#4c1d95"
      stroke: "#a78bfa"
      border-radius: 6
      font-color: "#ddd6fe"
      font-size: 10
    }
  }
  memories_db: "memories.db" {
    style: {
      fill: "#4c1d95"
      stroke: "#a78bfa"
      border-radius: 6
      font-color: "#ddd6fe"
      font-size: 10
    }
  }
  knowledge_db: "knowledge.db" {
    style: {
      fill: "#4c1d95"
      stroke: "#a78bfa"
      border-radius: 6
      font-color: "#ddd6fe"
      font-size: 10
    }
  }
  git_db: "git.db" {
    style: {
      fill: "#4c1d95"
      stroke: "#a78bfa"
      border-radius: 6
      font-color: "#ddd6fe"
      font-size: 10
    }
  }
}

# ── AGENTS ───────────────────────────────────────────────────
indexer_agent: "KnowledgeIndexer agent\nindexes, searches, deduplicates" {
  style: {
    fill: "#3b0764"
    stroke: "#c084fc"
    border-radius: 6
    font-color: "#e9d5ff"
    font-size: 10
  }
}

# ══════════════════════════════════════════════════════════════
# CONNECTIONS
# ══════════════════════════════════════════════════════════════

# Sources → Trigger
input.dropzone -> trigger: "file created"
input.obsidian -> input.dropzone: "copy/move files"
input.opencode -> input.dropzone: "agent file output"

# Trigger → Pipeline
trigger -> pipeline.convert: "new file event"

# Pipeline internal
pipeline.convert -> pipeline.frontmatter: "converted .md"
pipeline.frontmatter -> pipeline.route: "standardized"
pipeline.route -> pipeline.archive: "routed"

# Pipeline → Destinations
pipeline -> destinations: "routed files"

destinations.cmd.inbox -> post_process
destinations.cmd.finances -> post_process
destinations.knowledge.articles -> post_process
destinations.knowledge.notes -> post_process
destinations.self_dest.profile_dest -> post_process
destinations.self_dest.goals_dest -> post_process

# Post-process → DBs
post_process -> databases.tasks_db: "extracts tasks"
post_process -> databases.self_db: "extracts profile/habits"
post_process -> databases.memories_db: "extracts context"
post_process -> databases.knowledge_db: "extracts knowledge"
post_process -> databases.git_db: "extracts git info"

# Indexer
post_process -> indexer_agent: "triggers indexing"
indexer_agent -> databases.knowledge_db: "FTS5 search queries"

# ── LEGEND ───────────────────────────────────────────────────
legend: "LEGEND" {
  style: {
    fill: "#0f172a"
    stroke: "#334155"
    border-radius: 8
    font-color: "#94a3b8"
    font-size: 9
  }

  l1: "INPUT (cyan)" {
    style: {
      fill: "#0e7490"
      stroke: "#22d3ee"
      font-color: "#cffafe"
      font-size: 9
    }
  }
  l2: "PIPELINE (emerald)" {
    style: {
      fill: "#065f46"
      stroke: "#34d399"
      font-color: "#d1fae5"
      font-size: 9
    }
  }
  l3: "ROUTING (slate)" {
    style: {
      fill: "#1e293b"
      stroke: "#64748b"
      font-color: "#cbd5e1"
      font-size: 9
    }
  }
  l4: "DEST (amber)" {
    style: {
      fill: "#92400e"
      stroke: "#fbbf24"
      font-color: "#fde68a"
      font-size: 9
    }
  }
  l5: "EXTRACT (blue)" {
    style: {
      fill: "#1e3a5f"
      stroke: "#60a5fa"
      font-color: "#bfdbfe"
      font-size: 9
    }
  }
  l6: "DB (violet)" {
    style: {
      fill: "#4c1d95"
      stroke: "#a78bfa"
      font-color: "#ddd6fe"
      font-size: 9
    }
  }
}
